{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impresario:contract:axis-assessment:v1",
  "title": "AxisAssessment",
  "description": "Нормализованная оценка идеи по трём осям с provenance. Score ранжирует, доказанный blocker исключает; blocker без evidence-ссылки невалиден (schema-enforced).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "idea_ref",
    "run_id",
    "input_hash",
    "policy_version",
    "evidence_refs",
    "fit_strategy",
    "fit_market",
    "fit_standards",
    "strategy_blocker",
    "standards_blocker",
    "confidence",
    "evaluator",
    "evaluated_at"
  ],
  "properties": {
    "assessment_id": { "type": "string", "pattern": "^ASMT-[0-9]{3,}$" },
    "idea_ref": { "$ref": "#/$defs/ideaRef" },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{3,}$" },
    "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "policy_version": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "fit_strategy": { "$ref": "#/$defs/axisScore" },
    "fit_market": { "$ref": "#/$defs/axisScore" },
    "fit_standards": { "$ref": "#/$defs/axisScore" },
    "strategy_blocker": { "type": "boolean" },
    "strategy_blocker_ref": { "type": "string", "minLength": 1 },
    "standards_blocker": { "type": "boolean" },
    "standards_blocker_ref": { "type": "string", "minLength": 1 },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fit_strategy": { "type": "string" },
        "fit_market": { "type": "string" },
        "fit_standards": { "type": "string" }
      }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "evaluator": { "$ref": "#/$defs/actor" },
    "evaluated_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "strategy_blocker": { "const": true } } },
      "then": { "required": ["strategy_blocker_ref"] }
    },
    {
      "if": { "properties": { "standards_blocker": { "const": true } } },
      "then": { "required": ["standards_blocker_ref"] }
    }
  ],
  "$defs": {
    "axisScore": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 5 },
        { "const": "unknown" }
      ]
    },
    "ideaRef": { "type": "string", "pattern": "^idea://IDEA-[0-9]{3,}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["agent", "human"] },
        "id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "kind": { "const": "agent" } } },
      "then": { "required": ["kind", "id", "model", "prompt_version"] }
    }
  }
}
