{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impresario:contract:run-record:v1",
  "title": "RunRecord",
  "description": "Immutable запись прогона материализации RankedBacklog (docs/semantics.md). Фиксирует policy, входы (idea + input_hash + assessment) и версию бэклога до/после; изменение задним числом запрещено — новая материализация = новая запись.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "at",
    "mode",
    "policy_version",
    "weights",
    "backlog_ref",
    "backlog_version_after",
    "inputs"
  ],
  "properties": {
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{3,}$" },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "mode": { "const": "apply" },
    "policy_version": { "type": "string", "minLength": 1 },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fit_strategy", "fit_market", "fit_standards"],
      "properties": {
        "fit_strategy": { "type": "number", "exclusiveMinimum": 0 },
        "fit_market": { "type": "number", "exclusiveMinimum": 0 },
        "fit_standards": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "backlog_ref": {
      "type": "string",
      "pattern": "^backlog://BL-[a-z0-9][a-z0-9-]*$"
    },
    "backlog_version_before": { "type": "integer", "minimum": 1 },
    "backlog_version_after": { "type": "integer", "minimum": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idea_ref", "input_hash"],
        "properties": {
          "idea_ref": { "type": "string", "pattern": "^idea://IDEA-[0-9]{3,}$" },
          "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "assessment_ref": {
            "type": "string",
            "pattern": "^assessment://ASMT-[0-9]{3,}$"
          }
        }
      }
    },
    "actor": { "type": "string", "minLength": 1 }
  }
}
